# Owner settings, server-only. Ordinary users never enter these.
APP_URL=https://planner-pal.vercel.app
DATABASE_URL=
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
