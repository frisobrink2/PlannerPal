# Paid AI is OFF even if a key already exists. No key needed for the free workflow.
ENABLE_PAID_AI=false
# Optional only if the owner deliberately enables paid AI later:
PLANNERPAL_AI_KEY=
AI_MODEL=gpt-4.1-mini
